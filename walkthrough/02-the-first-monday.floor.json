      "segment": "seg-guest",
      "label": {
        "zh": "访客段 · 唯一没有登记册的",
        "en": "Guest — the only one with no register"
      },
      "why": {
        "zh": "你不会给来访者做纳管。按高峰日定容量，然后让它保持不受信任——刻意地不受信任，正是它安全的原因。",
        "en": "You do not enrol a visitor. Size it by the peak day and let it stay untrusted. Being untrusted on purpose is what makes it safe."
      },
      "criteria": {
        "zh": [
          "只出公网",
          "可证明的隔离",
          "按高峰日定容量，不按登记册"
        ],
        "en": [
          "Internet only",
          "Provably isolated",
          "Sized by the peak day, not by a register"
        ]
      },
