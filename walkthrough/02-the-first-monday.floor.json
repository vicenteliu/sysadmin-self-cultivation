    {
      "id": "addressing",
      "kind": "plan",
      "at": [
        30,
        13
      ],
      "segment": "seg-staff",
      "label": {
        "zh": "没有触发器的两件事",
        "en": "The two things nothing triggers"
      },
      "why": {
        "zh": "入职有入职日，离职有最后一天，转岗只有一次谈话——没有事件触发，所以它只加不减。而四十个非人身份里，没有一个有入职日、有主管、或有最后一天。",
        "en": "A joiner has a start date, a leaver has a last day, a mover has a conversation. No event fires, so the mover only ever adds. And of the forty non-human identities, not one has a start date, a manager, or a last day."
      },
      "criteria": {
        "zh": [
          "约 40 个非人身份，五分之二",
          "26 份设备凭据 + 约 12 个集成 + 2 个 break-glass",
          "尾部服务:没有任何离职事件到得了"
        ],
        "en": [
          "About 40 non-human identities, two in five",
          "26 device credentials, ~12 integrations, 2 break-glass",
          "The tail service: no leaver event reaches it at all"
        ]
      },
